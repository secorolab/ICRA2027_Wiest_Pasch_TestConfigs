version: 4
metadata:
  name: qd-nav-to-pose-secorolab-sidecar
  title: Manual rerun of the QD tiles -- nav-to-pose -- SecooraLab
  description: |
    One run of each of the 60 configurations shown in the comparison video (the two worst- and two
    best-covering configs of each QD batch), replayed so every start/goal, obstacle, trigger and
    parameter choice is reproduced exactly: scenario values come from each configuration's
    scenario.config, obstacle placement from its sim.config, and the A* flag from its sut.config.
    Nav2 runs MPPI or DWB per the config's params file (files/nav2_params_mppi.yaml or .._dwb.yaml,
    possibly the ``_astar`` variant), with the same GridBased.use_astar the campaign baked into the
    file the run loaded. Scenario, world and containers match the original campaign; what this run
    adds is the costmap sidecar (rosbags_costmap_to_csv over the three nav2 costmap topics) and the
    odom TF table (rosbags_tf_to_csv), which the costmap overlay in the video tooling reads.
execution:
  sizing: fixed
  containers:
    scenario:
      image: family:robovast-roqsim
      resources: {cpu: 2, memory: 1Gi}
    sut:
      image: family:robovast-roqsim
      resources: {cpu: 3.25, memory: 2Gi}
    simulation:
      backend: roqsim
      config: world/secorolab_nav2_standalone.yaml
      resources: {cpu: 2, memory: 2Gi}
  mode: ros2
  runs: 1
  runs_per_job: 1
  timeout: 1800
  scenario_file: nav_to_pose_qd.osc
  run_files:
  - 'files/*'
  - 'files/models/*.xacro'
  - 'environments/*'
  - 'environments/secorolab/maps/*'
  - 'environments/secorolab/json-ld/*'
  - 'environments/secorolab/3d-mesh/*'
  - 'environments/secorolab/mujoco/*'
  - 'world/*'
plugins:
- rosbags==0.11.5
configuration:
- name: b01-worst-1
  parameters:
    scenario:
      params_file: files/nav2_params_mppi.yaml
      map_file: environments/secorolab/maps/secorolab.yaml
      start_pose:
        position:
          x: 3.8817124394070355
          y: -4.669906936220329
        orientation:
          yaw: -3.1068961684142495
      goal_pose:
        position:
          x: 0.11120999550298816
          y: 2.7090965587059523
        orientation:
          yaw: 0.8642990829118515
      static_objects: []
      dynamic_objects:
      - entity_name: dynamic_0
        model: file:///config/files/models/box.sdf.xacro
        spawn_pose:
          position:
            x: -0.012691307429614551
            y: -0.6541563933109898
          orientation:
            yaw: -2.497596468612194
        xacro_arguments: width:=0.5, length:=0.5, height:=1.0
      spawn_trigger_point:
        x: -0.012691307429614551
        y: -0.6541563933109898
        z: 0.0
      spawn_trigger_threshold: 0.5578444800093415
      static_obstacle_distance: 0.7061095191677333
      dynamic_obstacle_lateral_distance: 0.4601676441228211
      dynamic_obstacle_trigger_distance: 0.5578444800093415
      controller_profile: files/nav2_params_mppi.yaml
      use_astar: false
    sim:
      overrides:
        components:
          static_obstacles:
            instances: []
          dynamic_obstacles:
            instances:
            - pose:
                position:
                  x: -0.012691307429614551
                  y: -0.6541563933109898
                orientation:
                  yaw: -2.497596468612194
              name: dynamic_0
              size:
              - 0.5
              - 0.5
              - 1.0
