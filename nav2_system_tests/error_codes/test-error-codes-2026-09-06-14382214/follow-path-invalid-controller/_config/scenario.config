test_scenario:
  params_file: files/nav2_params.yaml
  map_file: environments/hexagon/maps/hexagon.yaml
  mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  start_pose:
    position:
      x: -2.0
      y: -0.5
  nav2_test_id: error_codes/FollowPath/INVALID_CONTROLLER
  expect_success: false
  ec_action_name: /follow_path
  ec_action_type: nav2_msgs.action.FollowPath
  ec_goal_data: '{"path": {"poses": [{"header": {"frame_id": "map"}, "pose": {"position":
    {"x": -2.0, "y": 0.5, "z": 0.0}, "orientation": {"w": 1.0}}}]}, "controller_id":
    "no_such_controller", "goal_checker_id": "goal_checker", "progress_checker_id":
    "progress_checker"}'
