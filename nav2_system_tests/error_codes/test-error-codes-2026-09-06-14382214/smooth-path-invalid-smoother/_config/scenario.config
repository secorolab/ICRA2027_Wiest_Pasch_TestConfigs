test_scenario:
  params_file: files/nav2_params.yaml
  map_file: environments/hexagon/maps/hexagon.yaml
  mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  start_pose:
    position:
      x: -2.0
      y: -0.5
  nav2_test_id: error_codes/SmoothPath/INVALID_SMOOTHER
  expect_success: false
  ec_action_name: /smooth_path
  ec_action_type: nav2_msgs.action.SmoothPath
  ec_goal_data: '{"path": {"poses": [{"header": {"frame_id": "map"}, "pose": {"position":
    {"x": -2.0, "y": -0.5, "z": 0.0}, "orientation": {"w": 1.0}}}, {"header": {"frame_id":
    "map"}, "pose": {"position": {"x": 0.0, "y": 0.5, "z": 0.0}, "orientation": {"w":
    1.0}}}]}, "smoother_id": "no_such_smoother"}'
