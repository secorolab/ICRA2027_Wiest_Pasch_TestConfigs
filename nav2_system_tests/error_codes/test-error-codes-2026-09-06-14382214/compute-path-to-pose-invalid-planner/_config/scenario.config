test_scenario:
  params_file: files/nav2_params.yaml
  map_file: environments/hexagon/maps/hexagon.yaml
  mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  start_pose:
    position:
      x: -2.0
      y: -0.5
  nav2_test_id: error_codes/ComputePathToPose/INVALID_PLANNER
  expect_success: false
  ec_action_name: /compute_path_to_pose
  ec_action_type: nav2_msgs.action.ComputePathToPose
  ec_goal_data: '{"goal": {"header": {"frame_id": "map"}, "pose": {"position": {"x":
    0.0, "y": 0.5, "z": 0.0}, "orientation": {"w": 1.0}}}, "planner_id": "no_such_planner",
    "start": {"header": {"frame_id": "map"}, "pose": {"position": {"x": -2.0, "y":
    -0.5, "z": 0.0}, "orientation": {"w": 1.0}}}}'
