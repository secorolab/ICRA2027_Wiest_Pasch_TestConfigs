version: 3
metadata:
  name: planning
  title: Nav2 planner runtime analog, TurtleBot 4 + Nav2, in roqsim (MuJoCo)
  creators:
  - name: Wiest, Samuel
    identifiers: 0009-0002-9215-1238
  - name: Ortega Sainz, Argentina
    identifiers: 0000-0002-3873-4435
  - name: Pasch, Frederik
    identifiers: 0000-0002-2626-1538
  version: 1.0.0
  license: CC-BY-4.0
  keywords: [robotics, planning, navigation, ROS2, mujoco, roqsim, nav2, turtlebot4, behavior-tree]
  description: |
    Runtime blackbox analog of nav2_system_tests/src/planning (main; CSV row 46). The
    upstream suite directly exercises PlannerTester with synthetic costmaps, randomized
    endpoints, planner plugins and is_path_valid. This campaign runs the real planner
    through bt_navigator for 300 deterministic PathVariationRandom start/goal pairs,
    records the generated /plan, and includes /behavior_tree_log plus BT coverage.
    Direct synthetic-costmap and plugin assertions are documented as not portable in
    readme.md. The success rate is intentionally not an optimization objective; the
    purpose of this campaign is behavior-tree tracking across varied paths.
  agents:
  - id: turtlebot4
    configuration_files:
    - files/nav2_stack.launch.py
    - files/nav2_params.yaml
    derived_from: https://github.com/turtlebot/turtlebot4/tree/jazzy
    ros_distro: jazzy
  - id: simulation
    configuration_files:
    - world/nav2.yaml
    derived_from: https://github.com/cps-test-lab/roqsim
    ros_distro: jazzy

configuration:
# --- planner-runtime-nav-to-pose -----------------------------------------------
# Reachable goal exercises the configured planner through ComputePathToPose.
- name: planner-runtime-nav-to-pose
  parameters:
  - params_file: files/nav2_params.yaml
  - map_file: environments/hexagon/maps/hexagon.yaml
  - mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  - start_pose:
      position: {x: -2.0, y: -0.5}
  - goal_pose:
      position: {x: 0.0, y: 2.0}
  - nav2_test_id: test_planner_costmaps/runtime-navigation
  - expect_success: true
  - planner_case: none
  variations:
  - PathVariationRandom:
      scenario: {start: start_pose, goal: goal_pose}
      num_goal_poses: 1
      path_length: 3.0
      num_paths: 1
      path_length_tolerance: 0.5
      min_distance: 1.0
      seed: 42
      robot_diameter: 0.35
  sim:
    overrides:
      components:
        floorplan:
          mesh: /config/environments/hexagon/3d-mesh/hexagon.stl

- name: planner-path-valid-custom-footprint
  parameters:
  - params_file: files/nav2_params.yaml
  - map_file: environments/hexagon/maps/hexagon.yaml
  - mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  - start_pose: {position: {x: -2.0, y: -0.5}}
  - goal_pose: {position: {x: 0.0, y: 2.0}}
  - nav2_test_id: test_planner_is_path_valid/custom-footprint
  - expect_success: true
  - planner_case: custom-footprint
  sim: {overrides: {components: {floorplan: {mesh: /config/environments/hexagon/3d-mesh/hexagon.stl}}}}

- name: planner-path-valid-invalid-footprint
  parameters:
  - params_file: files/nav2_params.yaml
  - map_file: environments/hexagon/maps/hexagon.yaml
  - mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  - start_pose: {position: {x: -2.0, y: -0.5}}
  - goal_pose: {position: {x: 0.0, y: 2.0}}
