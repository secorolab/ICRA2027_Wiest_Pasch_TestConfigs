import osc.helpers
import osc.os
import osc.ros
import osc.nav2
import osc.remote
import osc.sim
import osc.dataops

# Nav2 WAIT BEHAVIOR test, ported from nav2_system_tests/src/behaviors/wait (main).
# One trial = one /wait action call with a fixed duration.
#
# DEVIATION FROM UPSTREAM -- stock behavior stack, full nav2 bringup. The upstream test
# (wait_behavior_tester.cpp) launches tb3_sandbox + nav2 bringup with the C++ tester
# (wait_behavior_tester) driving the `wait` behavior server's /wait action directly, over
# 4 parameterizations. Here the same bringup runs (files/nav2_stack.launch.py + the
# hexagon world) and the generic action_call primitive drives /wait -- the same device as
# the error_codes campaign and scenario_nav2_behavior_test.osc, because the scenario
# framework has no typed wait action.
#
# action_call returns SUCCESS only on STATUS_SUCCEEDED. The wait behavior SUCCEEDS after
# its configured duration, so for the success cases (Wait 1/2/5) expect_success=true and
# the cell emits end; the analysis additionally verifies the elapsed time (upstream's
# `elapsed >= wait_time` assertion) from the recorded /wait/_action status timestamp.
#
# NOT PORTED: Wait 10 + cancel. action_call has no cancel entry point (see
# scenario_nav2_behavior_test.osc for the same limitation). The upstream C++ tester drives
# behaviorTestCancel, which sends a goal then async_cancel_all_goals and asserts
# CANCELED/CANCELING; a mid-run cancel cannot be sequenced in this scenario framework.
#
# UPSTREAM ODDITY worth recording: CMakeLists.txt sets
# BT_NAVIGATOR_XML=navigate_to_pose_w_replanning_and_behavior.xml, a file that exists
# neither in the navigation2 source tree nor in the installed nav2_bt_navigator share
# directory (verified in the robovast image). It is immaterial to this test -- the /wait
# action is a behavior-server action, not a BT node -- but it is recorded so the CSV row's
# BT column is not silently treated as loadable.

scenario test_scenario:
    timeout(600s)

    map_file: string
    mesh_file: string
    start_pose: pose_3d
    params_file: string

    # The trial. wait_goal_data is a JSON goal literal: {"time": {"sec": N, "nanosec": 0}}.
    # The wait_ prefix is load-bearing -- it keeps the parameter namespace apart from
    # action_call's own __init__ arguments (action_name/action_type); see
    # scenario_nav2_behavior_test.osc's header for the recursion that bare names cause.
    wait_action_name: string
    wait_action_type: string
    wait_goal_data: string

    # Carried for grading. expect_success is true for every wait cell (the action
    # SUCCEEDS after the duration).
    nav2_test_id: string = ''
    expect_success: bool = true

    robot: differential_drive_robot

    do serial:
        serial:
            timeout(120s)
            wait_for_topics(topics: ['/clock'])
            check_data(topic_name: '/scan_sim',
                       topic_type: 'sensor_msgs.msg.LaserScan',
                       member_name: 'range_max',
                       comparison_operator: comparison_operator!gt,
                       expected_value: '0.0',
                       qos_profile: qos_preset_profiles!sensor_data)

        delete_entity(entity: 'dynamic_0')

        set_entity_state(entity: 'robot',
                         pose: pose_3d(
                             position: position_3d(x: start_pose.position.x,
                                                   y: start_pose.position.y,
                                                   z: 0.03m),
                             orientation: start_pose.orientation))

        parallel:
            # The sut channel stages the per-configuration parameter file at this path.
            ros_launch('', '/config/files/nav2_stack.launch.py',
                [key_value('map', os.abspath(common.get_scenario_file_directory() + "/" + map_file)),
                 key_value('params_file', common.get_scenario_file_directory() + '/' + params_file),
                 key_value('autostart', 'true'),
                 key_value('use_rviz', 'False'),
                 key_value('laserscan_gaussian_noise_std_deviation', '0.0'),
                 key_value('laserscan_random_drop_percentage', '0.0')],
                wait_for_shutdown: false) with:
                    remote('ipc:///ipc/sut')

            parallel:
                serial:
                    robot.init_nav2(start_pose)
                    bag_record([
                            '/clock',
                            '/tf',
                            '/tf_static',
                            '/map',
                            '/global_costmap/costmap',
                            '/local_costmap/costmap',
                            '/amcl_pose',
                            '/plan',
                            '/scan',
                            '/odom',
                            '/collision',
                            '/behavior_tree_log',
                            '/wait/_action/feedback',
                            '/wait/_action/status'
                        ],
                        hidden_topics: true,
                        use_sim_time: true,
                        timestamp_suffix: false)
                    # THE TRIAL: one /wait goal. Returns SUCCESS on STATUS_SUCCEEDED
                    # (the wait finishes) -- the same assertion wait_behavior_tester.cpp
                    # makes. The + '' is REQUIRED, see scenario_nav2_behavior_test.osc.
                    action_call(action_name: wait_action_name,
                                action_type: wait_action_type,
                                data: wait_goal_data + '')
                    emit end
                serial:
                    one_of:
                        log_check(values: ["Control loop missed its desired rate"]) with:
                            repeat(10)
                        check_data(topic_name: '/collision',
                                   topic_type: 'std_msgs.msg.Bool',
                                   member_name: 'data',
                                   comparison_operator: comparison_operator!eq,
                                   expected_value: 'True')
                    emit fail