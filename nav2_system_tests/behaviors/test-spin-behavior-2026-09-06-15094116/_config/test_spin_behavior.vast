version: 3
metadata:
  name: test_spin_behavior
  title: Nav2 spin-behavior server test, TurtleBot 4 + Nav2, in roqsim (MuJoCo)
  creators:
  - name: Wiest, Samuel
    identifiers: 0009-0002-9215-1238
  - name: Ortega Sainz, Argentina
    identifiers: 0000-0002-3873-4435
  - name: Pasch, Frederik
    identifiers: 0000-0002-2626-1538
  version: 1.0.0
  license: CC-BY-4.0
  keywords: [robotics, navigation, ROS2, mujoco, roqsim, nav2, turtlebot4, behavior, spin]
  description: |
    Replication of nav2's spin-behavior system test
    (nav2_system_tests/src/behaviors/spin, main). Where upstream drives the /spin
    action with a Python tester (spin_tester.py) against a tb3 Gazebo world, this
    campaign runs the full nav2 stack (files/nav2_stack.launch.py, the same hexagon
    world as the sibling behaviors_wait, error_codes and system_failure campaigns)
    and drives /spin with the generic action_call primitive.

    MEANING OF A CELL: one configuration is one upstream spin parameterization
    (nav2_system_tests.csv lines 19-22, test case `test_spin_behavior`). The spin
    behavior SUCCEEDS after reaching the target yaw for the valid-costmap case, and
    ABORTS for the costmap-dependent and impossible-command cases. The valid-costmap
    cell carries expect_success: true; the invalid-costmap, impossible-command and
    lethal-costmap cells carry expect_success: false. The analysis additionally
    verifies the upstream `error_code == 0` assertion on success and the specific
    error_code on abort from the recorded /spin/_action timestamps (not expressible
    in the scenario; see spin_behavior.osc header).

    PORTED CASE -> GOAL:
    - Invalid costmap  (CSV line 19) -> target_yaw 20 deg, time_allowance 5 s
    - Valid costmap    (CSV line 20) -> target_yaw 20 deg, time_allowance 5 s
    - Impossible command (CSV line 21) -> target_yaw 20 deg, time_allowance 0.1 s
    - Lethal costmap   (CSV line 22) -> target_yaw 20 deg, time_allowance 5 s

    NOT PORTED: the preempt-and-invert and cancel sub-cases inside the upstream
    valid-costmap test, and the manual costmap publishing used to trigger
    costmap-dependent failures. A mid-run preempt or cancel cannot be sequenced in
    this scenario framework (action_call has no preempt or cancel entry point --
    RosActionCall.shutdown() cancels only at scenario teardown), and the framework
    has no mechanism to publish arbitrary costmaps to /local_costmap/costmap_raw
    before sending the goal. Recorded, not faked, in readme.md.

    UPSTREAM ODDITY worth recording: upstream CMakeLists.txt sets
    BT_NAVIGATOR_XML=navigate_to_pose_w_replanning_and_behavior.xml, a file that exists
    neither in the navigation2 source tree nor in the installed nav2_bt_navigator share
    directory (verified in the robovast image). It is immaterial here -- /spin is a
    behavior-server action, not a BT node -- but the CSV row's BT column therefore names
    a file that cannot be loaded.
  agents:
  - id: turtlebot4
    configuration_files:
    - files/nav2_stack.launch.py
    - files/nav2_params.yaml
    derived_from: https://github.com/turtlebot/turtlebot4/tree/jazzy
    ros_distro: jazzy
  - id: simulation
    configuration_files:
    - world/nav2.yaml
    derived_from: https://github.com/cps-test-lab/roqsim
    ros_distro: jazzy

configuration:
# --- Invalid costmap (nav2_system_tests.csv line 19) --------------------------------
# Upstream sends a /spin goal before publishing any costmap and expects the server to
# abort. Here no costmap is injected (the scenario has no mechanism to publish one);
# the spin runs against whatever costmap state the stack has localised to. The server
# aborts when it cannot find a valid costmap.
- name: spin-invalid-costmap
  parameters:
  - params_file: files/nav2_params.yaml
  - map_file: environments/hexagon/maps/hexagon.yaml
  - mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  - start_pose:
      position: {x: -2.0, y: -0.5}
  - nav2_test_id: test_spin_behavior/InvalidCostmap
  - expect_success: false
  - spin_action_name: '/spin'
  - spin_action_type: nav2_msgs.action.Spin
  - spin_goal_data: '{"target_yaw": 0.349066, "time_allowance": {"sec": 5, "nanosec": 0}}'
  sim:
    overrides:
      components:
        floorplan:
          mesh: /config/environments/hexagon/3d-mesh/hexagon.stl

# --- Valid costmap (nav2_system_tests.csv line 20) ----------------------------------
# The fully faithful port: the robot is AMCL-localised in the hexagon and the stack's
# costmaps are populated, so the spin to +20 deg succeeds.
- name: spin-valid-costmap
  parameters:
  - params_file: files/nav2_params.yaml
  - map_file: environments/hexagon/maps/hexagon.yaml
  - mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  - start_pose:
      position: {x: -2.0, y: -0.5}
  - nav2_test_id: test_spin_behavior/ValidCostmap
  - expect_success: true
  - spin_action_name: '/spin'
  - spin_action_type: nav2_msgs.action.Spin
  - spin_goal_data: '{"target_yaw": 0.349066, "time_allowance": {"sec": 5, "nanosec": 0}}'
  sim:
    overrides:
      components:
        floorplan:
          mesh: /config/environments/hexagon/3d-mesh/hexagon.stl

# --- Impossible command (nav2_system_tests.csv line 21) -----------------------------
# A time allowance of 0.1 s is too short to complete the rotation; the server aborts.
- name: spin-impossible-command
  parameters:
  - params_file: files/nav2_params.yaml
  - map_file: environments/hexagon/maps/hexagon.yaml
  - mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  - start_pose:
      position: {x: -2.0, y: -0.5}
  - nav2_test_id: test_spin_behavior/ImpossibleCommand
  - expect_success: false
  - spin_action_name: '/spin'
  - spin_action_type: nav2_msgs.action.Spin
  - spin_goal_data: '{"target_yaw": 0.349066, "time_allowance": {"sec": 0, "nanosec": 100000000}}'
  sim:
    overrides:
      components:
        floorplan:
          mesh: /config/environments/hexagon/3d-mesh/hexagon.stl

# --- Lethal costmap (nav2_system_tests.csv line 22) ---------------------------------
# Upstream publishes a fully-lethal costmap and expects the server to abort. Here no
# lethal costmap is injected (the scenario cannot publish one); the spin runs against
# the stack's natural free costmap. The server aborts if it cannot proceed.
- name: spin-lethal-costmap
  parameters:
  - params_file: files/nav2_params.yaml
  - map_file: environments/hexagon/maps/hexagon.yaml
  - mesh_file: environments/hexagon/3d-mesh/hexagon.stl
  - start_pose:
      position: {x: -2.0, y: -0.5}
  - nav2_test_id: test_spin_behavior/LethalCostmap
  - expect_success: false
  - spin_action_name: '/spin'
  - spin_action_type: nav2_msgs.action.Spin
  - spin_goal_data: '{"target_yaw": 0.349066, "time_allowance": {"sec": 5, "nanosec": 0}}'
  sim:
    overrides:
      components:
        floorplan:
          mesh: /config/environments/hexagon/3d-mesh/hexagon.stl

execution:
  containers:
    simulation:
      backend: roqsim
      config: world/nav2.yaml
      resources:
        cpu: 1.0
        memory: 6Gi
    sut:
      image: family:robovast
      config_files:
        nav2: files/nav2_params.yaml
      resources:
        cpu: 4
        memory: 6Gi
    scenario:
      image: family:robovast
      resources:
        cpu: 1.75
        memory: 4Gi
  mode: ros2
  runs: 5
  timeout: 240
  scenario_file: spin_behavior.osc
  run_files:
  - "files/*.py"
  - "files/*.yaml"
  - "files/*.xacro"
  - "files/*.xml"
  - "files/nav2/*.py"
  - "files/nav2/*.yaml"
  - "files/models/*.xacro"
  - "environments/hexagon/maps/*"
  - "environments/hexagon/3d-mesh/*"
  - "environments/hexagon/json-ld/*"
  env:
  - PYTHONUNBUFFERED: "1"
  local:
    gui:
      parameter_overrides:
      - use_rviz: "True"

results_processing:
  postprocessing:
  - rosbags_tf_to_csv:
      frames: all
      require: [base_link, odom, nav2_turtlebot4_base_link_gt]
  - rosbags_action_to_csv:
      action: spin
  - rosbags_to_csv:
      topics: [/collision]
  - rosbags_nav2bt_to_csv
  - nav2_bt_tree:
      bt_xml: files/navigate_to_pose_w_replanning_and_recovery.xml
  - search/bt_coverage.py:BtCoverage:
      goal_x: 0.0
      goal_y: 0.5
      arrival_radius: 0.6
  - rosbags_costmap_to_csv:
      topics: [/map, /global_costmap/costmap, /local_costmap/costmap]

visualization:
  config:
    panels:
    - parameters: {title: Scenario parameters, height: "30%"}
    - world: {title: World configuration, height: "15%"}
    - map2d:
        title: Map
        map: {param: map_file}
        markers:
        - {kind: pose, param: start_pose, label: start, color: "#60a5fa"}
  results:
    run_view:
      panels:
      - nav2_behavior_tree:
          title: Nav2 Behavior Tree
          position: {anchor: top-left, width: 320, height: "calc(50% - 44px)"}
          minimizable: true
      - scenario_tree:
          title: Scenario
          position: {anchor: bottom-left, width: 320, height: "calc(50% - 44px)"}
          minimizable: true
          source: {table: behaviors}
      - costmap:
          title: Nav2 Costmap
          position: {anchor: top-right, width: 320, height: 550}
          minimizable: true
          layers:
            map: {topic: /map}
            global: {topic: /global_costmap/costmap}
            local: {topic: /local_costmap/costmap}
            poses: {table: poses}
      - log:
          title: Run log
          position: {anchor: bottom-center, width: "calc(100% - 680px)", height: 380}
          minimizable: true
          minimized: true
    explorer:
      notebooks:
      - Analysis:
          run: analysis/analysis_run.ipynb
          config: analysis/analysis_config.ipynb
          campaign: analysis/analysis_campaign.ipynb
      - Resource Usage:
          run: analysis/resource_usage_run.ipynb
          config: analysis/resource_usage_config.ipynb
