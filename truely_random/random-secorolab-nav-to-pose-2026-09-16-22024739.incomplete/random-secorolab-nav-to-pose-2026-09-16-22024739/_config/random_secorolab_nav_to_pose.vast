version: 4
metadata:
  name: random_secorolab_nav_to_pose
  title: Truly random nav_to_pose configurations, TurtleBot 4 + Nav2, in roqsim (MuJoCo)
  creators:
  - name: Wiest, Samuel
    identifiers: 0009-0002-9215-1238
  version: 1.0.0
  license: CC-BY-4.0
  keywords:
  - robotics
  - navigation
  - ROS2
  - mujoco
  - roqsim
  - nav2
  - turtlebot4
  - random
  - nav_to_pose
  description: "120 truly random nav_to_pose configurations for secorolab. Each randomly picks: a PathVariationRandom start/goal\
    \ pose, controller (50/50 MPPI/DWB), planner (use_astar True/False), static obstacle (50 %, random pose, fixed 0.5\xD7\
    0.5\xD71.0 m), dynamic obstacle (50 %, random pose, fixed 0.5\xD70.5\xD71.0 m, spawned when the robot is within a random\
    \ 0\u20135 m trigger distance of its pose)."
  agents:
  - id: turtlebot4
    configuration_files:
    - files/nav2_stack.launch.py
    - files/nav2_params.yaml
    derived_from: https://github.com/turtlebot/turtlebot4/tree/jazzy
    ros_distro: jazzy
  - id: simulation
    configuration_files:
    - world/nav2.yaml
    derived_from: https://github.com/cps-test-lab/roqsim
    ros_distro: jazzy
configuration:
- name: tr-000
  parameters:
    scenario:
      params_file: files/nav2_params_dwb_astar1.yaml
      map_file: environments/secorolab/maps/secorolab.yaml
      mesh_file: environments/secorolab/3d-mesh/secorolab.stl
      start_pose:
        position:
          x: -3.008
          y: -2.071
        orientation:
          yaw: -0.27602
      goal_pose:
        position:
          x: -2.48
          y: -4.42
        orientation:
          yaw: 0.089438
      spawn_trigger_point:
        x: -4.75
        y: -3.25
        z: 0.0
      spawn_trigger_threshold: 2.53
      dynamic_pose:
        position:
          x: -4.75
          y: -3.25
    sim:
      overrides:
        components:
          floorplan:
            mesh: /config/environments/secorolab/3d-mesh/secorolab.stl
          robot:
            diff_drive:
              max_linear_vel: 0.5
          static_obstacles:
            instances:
            - pose:
                position:
                  x: -3.35
                  y: -3.45
              size:
              - 0.5
              - 0.5
              - 1.0
- name: tr-001
  parameters:
    scenario:
      params_file: files/nav2_params_mppi_astar1.yaml
      map_file: environments/secorolab/maps/secorolab.yaml
      mesh_file: environments/secorolab/3d-mesh/secorolab.stl
      start_pose:
        position:
          x: 3.953
          y: 1.13
        orientation:
          yaw: -2.099382
      goal_pose:
        position:
          x: 4.354
          y: 5.74
        orientation:
          yaw: 1.788372
    sim:
