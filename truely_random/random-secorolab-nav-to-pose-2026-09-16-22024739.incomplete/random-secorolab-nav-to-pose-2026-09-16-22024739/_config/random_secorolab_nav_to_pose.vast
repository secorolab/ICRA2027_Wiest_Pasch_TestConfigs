execution:
  sizing: calibrated
  containers:
    simulation:
      calibration:
        size_on: 99
      backend: roqsim
      config: world/nav2.yaml
    sut:
      calibration:
        size_on: 99
      image: family:robovast-roqsim
      config_files:
        nav2: files/nav2_params.yaml
    scenario:
      calibration:
        size_on: 99
      image: family:robovast-roqsim
  mode: ros2
  runs: 1
  runs_per_job: 1
  timeout: 240
  scenario_file: nav_to_pose.osc
  run_files:
  - files/*
  - environments/*
  - files/models/*.xacro
  - environments/secorolab/maps/*
  - environments/secorolab/3d-mesh/*
  - environments/secorolab/json-ld/*
  - environments/secorolab/mujoco/*
  - world/*
  env:
  - PYTHONUNBUFFERED: '1'
results_processing:
  postprocessing:
  - rosbags_tf_to_csv:
      frames: all
      require:
      - base_link
      - odom
      - nav2_turtlebot4_base_link_gt
  - rosbags_action_to_csv:
      action: navigate_to_pose
  - rosbags_to_csv:
      topics:
      - /collision
  - rosbags_nav2bt_to_csv
  - nav2_bt_tree:
      bt_xml: files/navigate_to_pose_w_replanning_and_recovery.xml
  - search/bt_coverage.py:BtCoverage:
      goal_x: 0.0
      goal_y: 0.0
      arrival_radius: 0.6
  - rosbags_costmap_to_csv:
      topics:
      - /map
      - /global_costmap/costmap
      - /local_costmap/costmap
visualization:
  config:
    panels:
    - parameters:
        title: Scenario parameters
        height: 30%
    - world:
        title: World configuration
        height: 15%
    - map2d:
        title: Map
        map:
          param: map_file
        markers:
        - kind: pose
          param: start_pose
          label: start
          color: '#60a5fa'
        - kind: pose
          param: goal_pose
          label: goal
          color: '#4ade80'
  results:
    run_view:
      panels:
      - nav2_behavior_tree:
          title: Nav2 Behavior Tree
          position:
            anchor: top-left
            width: 320
            height: calc(50% - 44px)
          minimizable: true
      - costmap:
          title: Nav2 Costmap
          position:
            anchor: top-right
            width: 320
            height: 550
          minimizable: true
          layers:
            map:
              topic: /map
            global:
              topic: /global_costmap/costmap
            local:
              topic: /local_costmap/costmap
            poses:
              table: poses
      - log:
          title: Run log
          position:
            anchor: bottom-center
            width: calc(100% - 680px)
            height: 380
          minimizable: true
          minimized: true
