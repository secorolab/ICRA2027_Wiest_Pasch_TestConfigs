version: 4
metadata:
  name: random_hexagon_nav_to_pose
  title: Truly random nav_to_pose configurations, TurtleBot 4 + Nav2, in roqsim (MuJoCo)
  creators:
  - name: Wiest, Samuel
    identifiers: 0009-0002-9215-1238
  version: 1.0.0
  license: CC-BY-4.0
  keywords:
  - robotics
  - navigation
  - ROS2
  - mujoco
  - roqsim
  - nav2
  - turtlebot4
  - random
  - nav_to_pose
  description: "120 truly random nav_to_pose configurations for hexagon. Each randomly picks: a PathVariationRandom start/goal\
    \ pose, controller (50/50 MPPI/DWB), planner (use_astar True/False), static obstacle (50 %, random pose, fixed 0.5\xD7\
    0.5\xD71.0 m), dynamic obstacle (50 %, random pose, fixed 0.5\xD70.5\xD71.0 m, spawned when the robot is within a random\
    \ 0\u20135 m trigger distance of its pose)."
  agents:
  - id: turtlebot4
    configuration_files:
    - files/nav2_stack.launch.py
    - files/nav2_params.yaml
    derived_from: https://github.com/turtlebot/turtlebot4/tree/jazzy
    ros_distro: jazzy
  - id: simulation
    configuration_files:
    - world/nav2.yaml
    derived_from: https://github.com/cps-test-lab/roqsim
    ros_distro: jazzy
configuration:
- name: tr-000
  parameters:
    scenario:
      params_file: files/nav2_params_dwb_astar1.yaml
      map_file: environments/hexagon/maps/hexagon.yaml
      mesh_file: environments/hexagon/3d-mesh/hexagon.stl
      start_pose:
        position:
          x: -0.698
          y: -2.113
        orientation:
          yaw: -2.388456
      goal_pose:
        position:
          x: -0.738
          y: 1.483
        orientation:
          yaw: -1.251118
      spawn_trigger_point:
        x: 2.017
        y: -1.14
        z: 0.0
      spawn_trigger_threshold: 2.53
      dynamic_pose:
        position:
          x: 2.017
          y: -1.14
    sim:
      overrides:
        components:
          floorplan:
            mesh: /config/environments/hexagon/3d-mesh/hexagon.stl
          robot:
            diff_drive:
              max_linear_vel: 0.5
          static_obstacles:
            instances:
            - pose:
                position:
                  x: -1.333
                  y: -1.19
              size:
              - 0.5
              - 0.5
              - 1.0
- name: tr-001
  parameters:
    scenario:
      params_file: files/nav2_params_mppi_astar1.yaml
      map_file: environments/hexagon/maps/hexagon.yaml
