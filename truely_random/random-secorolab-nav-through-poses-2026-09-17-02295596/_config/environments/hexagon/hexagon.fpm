Floor plan: hexagon
    Defaults:
        walls:
            thickness: 0.2 m
            height: base_height
    var base_height = 1.27 m
    var col_radius = 0.3 m // radius = 0.15, workaround while using rectangle
    var col_height = 0.5 m
    var turtle_limbs = 1.397 m

    Space room:
        shape: Polygon points: [
       (0. m, -2.932938 m),
       (-2.54 m, -1.466469 m),
       (-2.54 m, 1.466469 m),
       (0. m, 2.932938 m),
       (2.54 m, 1.466469 m),
       (2.54 m, -1.466469 m)
        ]
        location:
            wrt: world
            of: this
            // translation: x: -0.3 m
            rotation: z: -90.0 deg
        features:
            Column one_one:
                shape: Rectangle width=col_radius, length=col_radius
                height: col_height
                location:
                    wrt: this
                    translation: x: -1.1 m, y: -1.1 m
            Column one_two:
                shape: Rectangle width=col_radius, length=col_radius
                height: col_height
                location:
                    wrt: this
                    translation: x: -1.1 m, y: 0 m
            Column one_three:
                shape: Rectangle width=col_radius, length=col_radius
                height: col_height
                location:
                    wrt: this
                    translation: x: -1.1 m, y: 1.1 m

            Column two_one:
                shape: Rectangle width=col_radius, length=col_radius
                height: col_height
                location:
                    wrt: this
                    translation: x: 0 m, y: -1.1 m
            Column two_two:
                shape: Rectangle width=col_radius, length=col_radius
                height: col_height
                location:
                    wrt: this
                    translation: x: 0 m, y: 0.0 m
            Column two_three:
                shape: Rectangle width=col_radius, length=col_radius
                height: col_height
                location:
                    wrt: this
                    translation: x: 0 m, y: 1.1 m

            Column three_one:
                shape: Rectangle width=col_radius, length=col_radius
                height: col_height
                location:
                    wrt: this
                    translation: x: 1.1 m, y: -1.1 m
            Column three_two:
                shape: Rectangle width=col_radius, length=col_radius
                height: col_height
                location:
                    wrt: this
                    translation: x: 1.1 m, y: 0 m
            Column three_three:
                shape: Rectangle width=col_radius, length=col_radius
                height: col_height
                location:
                    wrt: this
                    translation: x: 1.1 m, y: 1.1 m


            Column head:
                shape: Polygon points: [
                    (-1.1731752 m, 0. m),
                    (-0.5865876 m, 1.016 m),
                    (0.5865876 m, 1.016 m),
                    (1.1731752 m, 0. m),
                    (0.5865876 m, -1.016 m),
                    (-0.5865876 m, -1.016 m)
                ]
                height: 2.032 m
                location:
                    wrt: this
                    translation: x: 0.0 m, y: 3.5 m
                    rotation: z: 90.0 deg
            Column left_hand:
                shape: Polygon points: [
                    (-0.80655795 m, 0. m),
                    (-0.403278975 m, 0.6985 m),
                    (0.403278975 m, 0.6985 m),
                    (0.80655795 m, 0. m),
                    (0.403278975 m, -0.6985 m),
                    (-0.403278975 m, -0.6985 m)
                ]
                height: turtle_limbs
                location:
                    wrt: this
                    translation: x: 2.7 m, y: -1.8 m
                    rotation: z: 90.0 deg
            Column right_hand:
                shape: Polygon points: [
                    (-0.80655795 m, 0. m),
                    (-0.403278975 m, 0.6985 m),
                    (0.403278975 m, 0.6985 m),
                    (0.80655795 m, 0. m),
                    (0.403278975 m, -0.6985 m),
                    (-0.403278975 m, -0.6985 m)
                ]
                height: turtle_limbs
                location:
                    wrt: this
                    translation: x: -2.7 m, y: 1.8 m
                    rotation: z: 90.0 deg
            Column left_foot:
                shape: Polygon points: [
                    (-0.80655795 m, 0. m),
                    (-0.403278975 m, 0.6985 m),
                    (0.403278975 m, 0.6985 m),
                    (0.80655795 m, 0. m),
                    (0.403278975 m, -0.6985 m),
                    (-0.403278975 m, -0.6985 m)
                ]
                height: turtle_limbs
                location:
                    wrt: this
                    translation: x: 2.7 m, y: 1.8 m
                    rotation: z: 90.0 deg
            Column right_foot:
                shape: Polygon points: [
                    (-0.80655795 m, 0. m),
                    (-0.403278975 m, 0.6985 m),
                    (0.403278975 m, 0.6985 m),
                    (0.80655795 m, 0. m),
                    (0.403278975 m, -0.6985 m),
                    (-0.403278975 m, -0.6985 m)
                ]
                height: turtle_limbs
                location:
                    wrt: this
                    translation: x: -2.7 m, y: -1.8 m
                    rotation: z: 90.0 deg